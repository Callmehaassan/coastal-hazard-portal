# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/coastal_hazard

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google Earth Engine ---
# Path to the service account JSON key file (Phase 3 - pipeline)
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=./gee-service-account.json
GEE_PROJECT_ID=your-gcp-project-id

# --- LLM (Groq) ---
GROQ_API_KEY=your-groq-api-key

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- App ---
ENVIRONMENT=development
